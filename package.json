{
  "name": "traceglass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser journey regression workbench",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && node scripts/package.mjs",
    "fixture": "node scripts/fixture.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.0.0",
    "fflate": "^0.8.2",
    "globals": "^17.13.0",
    "prettier": "^3.5.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "Dharmendra (https://github.com/dharmendrathinks)",
  "repository": {
    "type": "git",
    "url": "https://github.com/dharmendrathinks/traceglass.git"
  },
  "homepage": "https://github.com/dharmendrathinks/traceglass#readme",
  "bugs": {
    "url": "https://github.com/dharmendrathinks/traceglass/issues"
  }
}
