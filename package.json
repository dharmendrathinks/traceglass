{
  "name": "traceglass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser journey regression workbench",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run test:e2e",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && node scripts/package.mjs",
    "fixture": "node scripts/fixture.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.310",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "fflate": "^0.8.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Dharmendra (https://github.com/dharmendrathinks)",
  "repository": {
    "type": "git",
    "url": "https://github.com/dharmendrathinks/traceglass.git"
  },
  "homepage": "https://github.com/dharmendrathinks/traceglass#readme",
  "bugs": {
    "url": "https://github.com/dharmendrathinks/traceglass/issues"
  }
}
