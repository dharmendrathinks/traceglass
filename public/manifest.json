{
  "manifest_version": 3,
  "name": "Traceglass — Journey comparison",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Compare browser journeys, investigate network regressions, and export local release evidence. No accounts or telemetry.",
  "devtools_page": "devtools.html",
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "action": { "default_title": "Open Traceglass workspace" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
